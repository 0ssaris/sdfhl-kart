<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SDFHL Grand Prix — Admin Tool</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a14;
    --panel: #12122a;
    --panel2: #0e0e22;
    --border: #2a2a4a;
    --text: #e8e8f0;
    --dim: #6a6a9a;
    --accent: #ff6b00;
    --accent2: #ffe600;
    --green: #27ae60;
    --red: #e74c3c;
    --blue: #3d9be9;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'VT323', monospace;
    padding: 20px 16px 60px;
    min-height: 100vh;
  }

  .container { max-width: 860px; margin: 0 auto; }

  .header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--border);
  }
  .title {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(10px, 2.2vw, 14px);
    color: var(--accent);
    text-shadow: 3px 3px 0 #7a1c00;
    margin-bottom: 6px;
    line-height: 1.8;
  }
  .subtitle { font-size: 18px; color: var(--dim); letter-spacing: 3px; }

  /* ── PANELS ── */
  .panel {
    background: var(--panel);
    border: 2px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 14px;
  }
  .panel-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--dim);
    letter-spacing: 3px;
    margin-bottom: 14px;
  }

  .result-btns { display: flex; gap: 4px; }
  .result-btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    padding: 5px 8px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .result-btn.win   { border-color: var(--green); color: var(--green); background: rgba(39,174,96,0.08); }
  .result-btn.win:hover   { background: rgba(39,174,96,0.25); color: var(--green); border-color: var(--green); }
  .result-btn.tie   { border-color: var(--accent2); color: var(--accent2); background: rgba(255,230,0,0.08); }
  .result-btn.tie:hover   { background: rgba(255,230,0,0.2); color: var(--accent2); border-color: var(--accent2); }
  .result-btn.loss  { border-color: var(--dim); color: var(--dim); background: rgba(106,106,154,0.08); }
  .result-btn.loss:hover  { background: rgba(106,106,154,0.2); color: var(--dim); border-color: var(--dim); }

  /* ── INPUTS ── */
  input[type="text"], input[type="password"], input[type="number"], select {
    font-family: 'VT323', monospace;
    font-size: 20px;
    border-radius: 4px;
    border: 2px solid var(--border);
    background: var(--panel2);
    color: var(--text);
    padding: 6px 10px;
    outline: none;
    transition: border-color 0.15s;
  }
  input:focus, select:focus { border-color: var(--accent); }
  input[type="number"] { width: 72px; text-align: center; }

  /* ── BUTTONS ── */
  button {
    font-family: 'VT323', monospace;
    font-size: 18px;
    border-radius: 4px;
    border: 2px solid var(--border);
    background: var(--panel2);
    color: var(--text);
    padding: 7px 14px;
    cursor: pointer;
    transition: all 0.15s;
    outline: none;
  }
  button:hover { border-color: var(--accent); color: var(--accent); }

  .btn-primary {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    padding: 12px 24px;
    letter-spacing: 2px;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.4);
    width: 100%;
  }
  .btn-primary:hover { background: #ff8c33; border-color: #ff8c33; color: #fff; }
  .btn-primary:disabled { background: #333; border-color: #444; color: #666; cursor: not-allowed; }

  .btn-load {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    padding: 9px 16px;
    letter-spacing: 1px;
    border-color: var(--blue);
    color: var(--blue);
    background: rgba(61,155,233,0.08);
  }
  .btn-load:hover { background: rgba(61,155,233,0.2); color: var(--blue); border-color: var(--blue); }

  /* ── TOKEN ROW ── */
  .token-row {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .token-row input { flex: 1; min-width: 200px; }
  .token-saved-tag {
    font-family: 'Press Start 2P', monospace;
    font-size: 6px;
    color: var(--green);
    background: rgba(39,174,96,0.1);
    border: 1px solid rgba(39,174,96,0.3);
    border-radius: 3px;
    padding: 3px 6px;
    display: none;
  }

  /* ── WEEK SELECTOR ── */
  .week-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .week-label { font-size: 22px; color: var(--dim); }
  .week-pips { display: flex; gap: 5px; align-items: center; }
  .pip {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--border);
    border: 1px solid var(--dim);
    cursor: pointer;
    transition: all 0.15s;
  }
  .pip.active { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 5px var(--accent); }

  /* ── TEAM TABLE ── */
  .team-table { width: 100%; border-collapse: collapse; }
  .team-table th {
    font-family: 'Press Start 2P', monospace;
    font-size: 6px;
    color: var(--dim);
    letter-spacing: 2px;
    padding: 0 8px 10px;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .team-table td {
    padding: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    vertical-align: middle;
  }
  .team-table tr:last-child td { border-bottom: none; }

  .team-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    display: inline-block;
    border: 2px solid rgba(255,255,255,0.25);
    vertical-align: middle;
    margin-right: 6px;
  }
  .team-name-cell { font-size: 20px; white-space: nowrap; }

  /* Item toggle buttons */
  .item-toggles { display: flex; gap: 4px; flex-wrap: wrap; }
  .item-btn {
    font-size: 18px;
    padding: 3px 5px;
    border: 2px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.03);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    opacity: 0.4;
    line-height: 1;
  }
  .item-btn:hover { opacity: 0.8; border-color: rgba(255,255,255,0.3); background: none; color: inherit; }
  .item-btn.active {
    opacity: 1;
    border-color: var(--accent2);
    background: rgba(255,230,0,0.1);
    box-shadow: 0 0 6px rgba(255,230,0,0.2);
  }
  .item-btn.disabled-btn {
    cursor: not-allowed;
    opacity: 0.15;
  }

  /* ── BANANA PEELS ── */
  .bp-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .bp-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(160,128,0,0.15);
    border: 1px solid #a08000;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 19px;
  }
  .bp-remove {
    color: var(--red);
    cursor: pointer;
    font-size: 15px;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    line-height: 1;
  }
  .bp-remove:hover { color: #ff9999; background: none; border: none; }
  .bp-add-row { display: flex; gap: 8px; align-items: center; margin-top: 10px; }
  .bp-add-row input { width: 80px; }
  .bp-none { font-size: 18px; color: rgba(255,255,255,0.2); }

  /* ── FINISHED TEAMS ── */
  .finished-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 8px;
  }
  .finished-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    padding: 6px 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
    user-select: none;
  }
  .finished-item.checked {
    border-color: var(--accent2);
    background: rgba(255,230,0,0.07);
  }
  .finished-item input[type="checkbox"] { display: none; }
  .finished-check {
    width: 14px; height: 14px;
    border: 2px solid var(--border);
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px;
    flex-shrink: 0;
    transition: all 0.15s;
  }
  .finished-item.checked .finished-check {
    border-color: var(--accent2);
    background: var(--accent2);
    color: #000;
  }

  /* ── STATUS ── */
  .status-bar {
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 18px;
    text-align: center;
    letter-spacing: 1px;
    display: none;
    margin-bottom: 14px;
  }
  .status-bar.loading {
    display: block;
    background: rgba(61,155,233,0.1);
    border: 1px solid var(--blue);
    color: var(--blue);
  }
  .status-bar.success {
    display: block;
    background: rgba(39,174,96,0.1);
    border: 1px solid var(--green);
    color: var(--green);
  }
  .status-bar.error {
    display: block;
    background: rgba(231,76,60,0.1);
    border: 1px solid var(--red);
    color: var(--red);
  }

  /* ── PREVIEW ── */
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 8px;
  }
  .preview-team {
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 8px 10px;
    font-size: 17px;
  }
  .preview-team-name { margin-bottom: 4px; }
  .preview-space {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--dim);
  }
  .preview-items { margin-top: 4px; font-size: 16px; letter-spacing: 2px; }
  .preview-bar-bg {
    height: 4px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    margin-top: 5px;
    overflow: hidden;
  }
  .preview-bar-fill {
    height: 100%;
    border-radius: 2px;
    min-width: 2px;
  }
</style>
</head>
<body>
<div class="container">

  <!-- HEADER -->
  <div class="header">
    <div class="title">⚙️ GRAND PRIX — ADMIN TOOL</div>
    <div class="subtitle">PUSH UPDATES TO LIVE SITE</div>
  </div>

  <!-- STATUS -->
  <div id="statusBar" class="status-bar"></div>

  <!-- GITHUB TOKEN -->
  <div class="panel">
    <div class="panel-title">🔑 GITHUB ACCESS</div>
    <div class="token-row">
      <input type="password" id="tokenInput" placeholder="Paste your GitHub token here..." autocomplete="off">
      <button class="btn-load" onclick="loadFromGitHub()">⬇ LOAD CURRENT DATA</button>
      <span class="token-saved-tag" id="tokenSavedTag">TOKEN SAVED</span>
    </div>
    <div style="margin-top:8px; font-size:16px; color:var(--dim)">
      Token is saved locally in your browser. Never shared or uploaded.
    </div>
  </div>

  <!-- WEEK -->
  <div class="panel">
    <div class="panel-title">📅 CURRENT WEEK</div>
    <div class="week-row">
      <div class="week-label">Week</div>
      <select id="weekSelect" onchange="updateWeekPips()">
        <option value="1">1</option><option value="2">2</option>
        <option value="3">3</option><option value="4">4</option>
        <option value="5">5</option><option value="6">6</option>
        <option value="7">7</option><option value="8">8</option>
        <option value="9">9</option>
      </select>
      <div class="week-pips" id="weekPips"></div>
    </div>
  </div>

  <!-- TEAMS -->
  <div class="panel">
    <div class="panel-title">🏎 TEAM STANDINGS</div>
    <div style="overflow-x:auto">
      <table class="team-table">
        <thead>
          <tr>
            <th>TEAM</th>
            <th>RESULT</th>
            <th>SPACES</th>
            <th>ITEMS HELD (MAX 2) — click to toggle</th>
          </tr>
        </thead>
        <tbody id="teamTableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- BANANA PEELS -->
  <div class="panel">
    <div class="panel-title">🍌 ACTIVE BANANA PEELS</div>
    <div id="bpList"></div>
    <div class="bp-add-row">
      <input type="number" id="bpInput" placeholder="Space #" min="1" max="19">
      <button onclick="addBananaPeel()">+ ADD PEEL</button>
    </div>
  </div>

  <!-- FINISHED TEAMS -->
  <div class="panel">
    <div class="panel-title">🏁 FINISHED TEAMS (crossed space 20)</div>
    <div class="finished-grid" id="finishedGrid"></div>
  </div>

  <!-- PREVIEW -->
  <div class="panel">
    <div class="panel-title">👁 LIVE PREVIEW</div>
    <div class="preview-grid" id="preview"></div>
  </div>

  <!-- PUSH BUTTON -->
  <button class="btn-primary" id="pushBtn" onclick="pushToGitHub()">
    🚀 PUSH TO LIVE SITE
  </button>

</div>

<script>
// ── CONFIG ──
const REPO_OWNER = "0ssaris";
const REPO_NAME  = "sdfhl-kart";
const FILE_PATH  = "index.html";

const TEAMS = [
  { name: "Blue",   color: "#b4c6e7" },
  { name: "Pink",   color: "#ef2fc6" },
  { name: "Purple", color: "#7030a0" },
  { name: "Brown",  color: "#7f6000" },
  { name: "Orange", color: "#f86308" },
  { name: "Red",    color: "#ff0000" },
  { name: "Green",  color: "#00b050" },
  { name: "Grey",   color: "#757070" },
  { name: "Yellow", color: "#ffff00" },
];

const ITEMS = [
  { emoji: "🍄", name: "Mushroom"    },
  { emoji: "⭐", name: "Star"        },
  { emoji: "🐢", name: "Green Shell" },
  { emoji: "🔴", name: "Red Shell"   },
  { emoji: "🍌", name: "Banana Peel" },
  { emoji: "🔵", name: "Blue Shell"  },
  { emoji: "⚡", name: "Lightning"   },
];

// ── STATE ──
let currentSha = null;
let formState = {
  week: 1,
  teams: TEAMS.map(t => ({ ...t, space: 0, items: [] })),
  bananaPeels: [],
  finishedTeams: [],
};

// ── INIT ──
window.onload = () => {
  const saved = localStorage.getItem("sdfhl_admin_token");
  if (saved) {
    document.getElementById("tokenInput").value = saved;
    document.getElementById("tokenSavedTag").style.display = "inline-block";
  }
  renderAll();
};

// ── RENDER ──
function renderAll() {
  renderWeekPips();
  renderTeamTable();
  renderBananaPeels();
  renderFinishedTeams();
  renderPreview();
}

function renderWeekPips() {
  const week = parseInt(document.getElementById("weekSelect").value);
  const container = document.getElementById("weekPips");
  container.innerHTML = Array.from({length: 9}, (_, i) =>
    `<div class="pip${i < week ? ' active' : ''}" onclick="setWeek(${i+1})"></div>`
  ).join('');
}

function updateWeekPips() {
  formState.week = parseInt(document.getElementById("weekSelect").value);
  renderWeekPips();
  renderPreview();
}

function setWeek(w) {
  document.getElementById("weekSelect").value = w;
  formState.week = w;
  renderWeekPips();
  renderPreview();
}

function renderTeamTable() {
  const tbody = document.getElementById("teamTableBody");
  tbody.innerHTML = formState.teams.map((team, ti) => {
    const itemBtns = ITEMS.map(item => {
      const held = team.items.includes(item.emoji);
      const atMax = team.items.length >= 2 && !held;
      return `<button
        class="item-btn${held ? ' active' : ''}${atMax ? ' disabled-btn' : ''}"
        title="${item.name}"
        onclick="toggleItem(${ti}, '${item.emoji}')"
      >${item.emoji}</button>`;
    }).join('');

    return `<tr>
      <td class="team-name-cell">
        <span class="team-dot" style="background:${team.color}"></span>${team.name}
      </td>
      <td>
        <div class="result-btns">
          <button class="result-btn win"  onclick="applyResult(${ti}, 'win')"  title="+3 spaces">W</button>
          <button class="result-btn tie"  onclick="applyResult(${ti}, 'tie')"  title="+1 space">T</button>
          <button class="result-btn loss" onclick="applyResult(${ti}, 'loss')" title="+0 spaces">L</button>
        </div>
      </td>
      <td>
        <input type="number" min="0" max="30" value="${team.space}"
          onchange="setSpace(${ti}, this.value)"
          oninput="setSpace(${ti}, this.value)">
      </td>
      <td>
        <div class="item-toggles">${itemBtns}</div>
      </td>
    </tr>`;
  }).join('');
}

function applyResult(ti, result) {
  const delta = result === 'win' ? 3 : result === 'tie' ? 1 : 0;
  formState.teams[ti].space = Math.max(0, formState.teams[ti].space + delta);
  renderTeamTable();
  renderPreview();
}

function setSpace(ti, val) {
  formState.teams[ti].space = Math.max(0, parseInt(val) || 0);
  renderPreview();
}

function toggleItem(ti, emoji) {
  const team = formState.teams[ti];
  const idx = team.items.indexOf(emoji);
  if (idx >= 0) {
    team.items.splice(idx, 1);
  } else {
    if (team.items.length >= 2) return;
    team.items.push(emoji);
  }
  renderTeamTable();
  renderPreview();
}

function renderBananaPeels() {
  const list = document.getElementById("bpList");
  if (formState.bananaPeels.length === 0) {
    list.innerHTML = `<div class="bp-none" style="margin-bottom:10px">No active peels</div>`;
    return;
  }
  list.innerHTML = `<div class="bp-row" style="margin-bottom:10px">` +
    formState.bananaPeels.map((sp, i) =>
      `<div class="bp-tag">🍌 Space ${sp}
        <button class="bp-remove" onclick="removeBananaPeel(${i})">✕</button>
      </div>`
    ).join('') + `</div>`;
}

function addBananaPeel() {
  const val = parseInt(document.getElementById("bpInput").value);
  if (isNaN(val) || val < 1 || val > 19) return;
  if (!formState.bananaPeels.includes(val)) {
    formState.bananaPeels.push(val);
    formState.bananaPeels.sort((a, b) => a - b);
  }
  document.getElementById("bpInput").value = "";
  renderBananaPeels();
}

function removeBananaPeel(i) {
  formState.bananaPeels.splice(i, 1);
  renderBananaPeels();
}

function renderFinishedTeams() {
  const grid = document.getElementById("finishedGrid");
  grid.innerHTML = formState.teams.map(team => {
    const checked = formState.finishedTeams.includes(team.name);
    return `<label class="finished-item${checked ? ' checked' : ''}" onclick="toggleFinished('${team.name}')">
      <div class="finished-check">${checked ? '✓' : ''}</div>
      <span class="team-dot" style="background:${team.color}"></span>
      <span style="font-size:18px">${team.name}</span>
    </label>`;
  }).join('');
}

function toggleFinished(name) {
  const idx = formState.finishedTeams.indexOf(name);
  if (idx >= 0) formState.finishedTeams.splice(idx, 1);
  else formState.finishedTeams.push(name);
  renderFinishedTeams();
}

function renderPreview() {
  const sorted = [...formState.teams].sort((a, b) => b.space - a.space);
  document.getElementById("preview").innerHTML = sorted.map(team => {
    const pct = Math.min(100, Math.round((Math.min(team.space, 20) / 20) * 100));
    const itemsStr = team.items.join(' ') || '—';
    return `<div class="preview-team">
      <div class="preview-team-name">
        <span class="team-dot" style="background:${team.color}"></span>${team.name}
      </div>
      <div class="preview-space">SPACE ${team.space} / 20</div>
      <div class="preview-items">${itemsStr}</div>
      <div class="preview-bar-bg">
        <div class="preview-bar-fill" style="width:${pct}%;background:${team.color}"></div>
      </div>
    </div>`;
  }).join('');
}

// ── GITHUB LOAD ──
async function loadFromGitHub() {
  const token = getToken();
  if (!token) return showStatus("error", "Paste your GitHub token first.");

  showStatus("loading", "Loading current data from GitHub...");
  try {
    const res = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`,
      { headers: { Authorization: `token ${token}`, Accept: "application/vnd.github.v3+json" } }
    );
    if (!res.ok) throw new Error(`GitHub returned ${res.status} — check your token and repo access.`);
    const data = await res.json();
    currentSha = data.sha;
    const content = decodeURIComponent(escape(atob(data.content.replace(/\n/g, ''))));
    parseAndApplyRaceData(content);
    renderAll();
    showStatus("success", "✓ Loaded! Make your changes and push when ready.");
  } catch (e) {
    showStatus("error", e.message);
  }
}

function parseAndApplyRaceData(html) {
  const match = html.match(/const RACE_DATA\s*=\s*\{([\s\S]*?)\};/);
  if (!match) return;
  const block = match[1];

  // Week
  const wm = block.match(/week:\s*(\d+)/);
  if (wm) {
    formState.week = parseInt(wm[1]);
    document.getElementById("weekSelect").value = formState.week;
  }

  // Teams — space and items
  const teamMatches = [...block.matchAll(/\{[^}]+name:\s*"([^"]+)"[^}]+space:\s*(\d+)[^}]+items:\s*\[([^\]]*)\][^}]*\}/g)];
  teamMatches.forEach(m => {
    const name = m[1], space = parseInt(m[2]), itemsRaw = m[3].trim();
    const team = formState.teams.find(t => t.name === name);
    if (!team) return;
    team.space = space;
    team.items = itemsRaw ? itemsRaw.split(',').map(s => s.trim().replace(/"/g, '').replace(/'/g, '')) : [];
  });

  // Banana peels
  const bpm = block.match(/bananaPeels:\s*\[([^\]]*)\]/);
  if (bpm) {
    const bpStr = bpm[1].trim();
    formState.bananaPeels = bpStr ? bpStr.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n)) : [];
  }

  // Finished teams
  const ftm = block.match(/finishedTeams:\s*\[([^\]]*)\]/);
  if (ftm) {
    const ftStr = ftm[1].trim();
    formState.finishedTeams = ftStr ? ftStr.split(',').map(s => s.trim().replace(/"/g, '').replace(/'/g, '')) : [];
  }
}

// ── GITHUB PUSH ──
async function pushToGitHub() {
  const token = getToken();
  if (!token) return showStatus("error", "Paste your GitHub token first.");

  document.getElementById("pushBtn").disabled = true;
  showStatus("loading", "Pushing to GitHub...");

  try {
    // Always fetch latest SHA before pushing
    const getRes = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`,
      { headers: { Authorization: `token ${token}`, Accept: "application/vnd.github.v3+json" } }
    );
    if (!getRes.ok) throw new Error(`Could not fetch file: ${getRes.status}`);
    const getData = await getRes.json();
    currentSha = getData.sha;
    let content = decodeURIComponent(escape(atob(getData.content.replace(/\n/g, ''))));

    // Build new RACE_DATA block
    const newBlock = buildRaceDataBlock();

    // Replace block in file
    const updated = content.replace(/const RACE_DATA\s*=\s*\{[\s\S]*?\};/, newBlock);
    if (updated === content) throw new Error("Could not find RACE_DATA block in file — has the file been modified manually?");

    // Push
    const putRes = await fetch(
      `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/contents/${FILE_PATH}`,
      {
        method: "PUT",
        headers: {
          Authorization: `token ${token}`,
          "Content-Type": "application/json",
          Accept: "application/vnd.github.v3+json",
        },
        body: JSON.stringify({
          message: `Grand Prix — Week ${formState.week} update`,
          content: btoa(unescape(encodeURIComponent(updated))),
          sha: currentSha,
        }),
      }
    );
    if (!putRes.ok) {
      const err = await putRes.json();
      throw new Error(err.message || `Push failed: ${putRes.status}`);
    }

    showStatus("success", `✓ Week ${formState.week} pushed! Live site updates in ~60 seconds.`);
  } catch (e) {
    showStatus("error", e.message);
  } finally {
    document.getElementById("pushBtn").disabled = false;
  }
}

// ── HELPERS ──
function getToken() {
  const t = document.getElementById("tokenInput").value.trim();
  if (t) {
    localStorage.setItem("sdfhl_admin_token", t);
    document.getElementById("tokenSavedTag").style.display = "inline-block";
  }
  return t;
}

function showStatus(type, msg) {
  const bar = document.getElementById("statusBar");
  bar.className = `status-bar ${type}`;
  bar.textContent = msg;
  bar.style.display = "block";
  if (type === "success") setTimeout(() => { bar.style.display = "none"; }, 5000);
}

function buildRaceDataBlock() {
  const teamsStr = formState.teams.map(t => {
    const itemsStr = t.items.map(e => `"${e}"`).join(", ");
    return `    { name: "${t.name}",   color: "${t.color}", space: ${t.space}, items: [${itemsStr}] }`;
  }).join(",\n");

  const bpStr  = formState.bananaPeels.join(", ");
  const ftStr  = formState.finishedTeams.map(n => `"${n}"`).join(", ");

  return `const RACE_DATA = {

  week: ${formState.week},         // Current week (1–9)
  totalWeeks: 9,

  //
  // TEAMS — update name, space, and items each week.
  //
  // color   : team hex color (pick one per team and keep it all season)
  // space   : total spaces earned so far (0 = not moved yet)
  // items   : items currently held — use these emoji exactly:
  //           "🍄" Mushroom  "⭐" Star     "🐢" Green Shell
  //           "🔴" Red Shell "🔵" Blue Shell "🍌" Banana Peel  "⚡" Lightning
  //
  teams: [
${teamsStr},
  ],

  // Spaces where banana peels are currently placed on the track.
  bananaPeels: [${bpStr}],

  // Teams that have crossed the finish line, in order of finish.
  finishedTeams: [${ftStr}],

};`;
}
